{
  "name": "indian-stock-analyzer",
  "version": "1.0.0",
  "description": "Real-time Indian Stock Analyzer (NSE/BSE) - React + Node + Yahoo Finance",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "install:all": "npm install --workspace=server && npm install --workspace=client",
    "build": "npm run build --workspace=client"
  },
  "keywords": [
    "nse",
    "bse",
    "stocks",
    "india",
    "trading",
    "nifty"
  ],
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
