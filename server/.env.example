# === REQUIRED ===
# Port (Render sets this automatically; override for local)
PORT=5000

# Comma-separated allowed CORS origins
# Local:  CLIENT_URL=http://localhost:5173
# Prod:   CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# === SMTP (for daily 7 PM IST newsletter emails) ===
# Without these, emails are logged to console (mock mode)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# === OPTIONAL: Angel One SmartAPI for tick-by-tick data ===
# Get from https://smartapi.angelbroking.com
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
